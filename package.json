{
  "name": "bulllite",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "build": "pnpm --filter bullmq-memory-backend build",
    "typecheck": "pnpm --filter bullmq-memory-backend typecheck",
    "test": "pnpm --filter bullmq-memory-backend test && pnpm --filter @bulllite/examples test",
    "test:readme": "pnpm --filter bullmq-memory-backend build && pnpm --filter @bulllite/examples test",
    "conformance": "pnpm --filter @bulllite/conformance conformance",
    "bullmq:use": "node scripts/use-bullmq.mjs"
  }
}
