{
  "name": "bullmq-memory-backend",
  "version": "0.1.0-alpha.1",
  "description": "Unofficial in-memory, Redis-free backend for BullMQ v6 IQueueBackend, for testing and local development.",
  "license": "MIT",
  "author": "KamelotWalker",
  "homepage": "https://github.com/KamelotWalker/BullLite#readme",
  "bugs": { "url": "https://github.com/KamelotWalker/BullLite/issues" },
  "publishConfig": { "access": "public", "tag": "alpha" },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "bullmq",
    "queue",
    "in-memory",
    "testing",
    "backend",
    "redis-free"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KamelotWalker/BullLite.git",
    "directory": "packages/memory"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "bullmq": "^6.3.9"
  },
  "devDependencies": {
    "bullmq": "6.4.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^2.1.0"
  }
}
